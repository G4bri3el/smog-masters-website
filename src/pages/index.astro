---
import ContactCTA from '../components/ContactCTA.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import LocationSection from '../components/LocationSection.astro';
import ServiceSection from '../components/ServiceSection.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import { site } from '../config/site';
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title={site.seo.title} description={site.seo.description}>
  <Header />
  <main>
    <Hero />
    <ServiceSection />
    <WhyChooseUs />
    <LocationSection />
    <ContactCTA />
  </main>
  <Footer />
</MainLayout>

