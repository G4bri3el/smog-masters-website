---
import { addressLines, site } from '../config/site';

interface Props {
  variant?: 'light' | 'dark';
  compact?: boolean;
}

const { variant = 'light', compact = false } = Astro.props;
const isDark = variant === 'dark';
---

<address
  class:list={[
    'not-italic',
    compact ? 'space-y-1 text-sm' : 'space-y-2',
    isDark ? 'text-slate-200' : 'text-text-secondary',
  ]}
>
  <p class:list={['font-semibold', isDark ? 'text-white' : 'text-navy']}>
    {site.businessName}
  </p>
  <p>
    {addressLines[0]}<br />
    {addressLines[1]}
  </p>
  <p>
    <a
      href={site.phoneHref}
      class:list={[
        'font-semibold',
        isDark ? 'text-white hover:text-green-200' : 'text-navy hover:text-brand-green',
      ]}
    >
      {site.phoneDisplay}
    </a>
  </p>
</address>

