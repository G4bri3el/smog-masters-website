---
import BusinessInfo from './BusinessInfo.astro';
import { currentYear, site } from '../config/site';
---

<footer class="border-t border-slate-200 bg-white py-10">
  <div class="container-shell grid gap-8 sm:grid-cols-[1fr_auto] sm:items-end">
    <div>
      <BusinessInfo compact />
    </div>
    <p class="text-sm text-text-secondary">
      &copy; {currentYear} {site.businessName}.
    </p>
  </div>
</footer>

