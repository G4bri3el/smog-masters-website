---
import SectionHeading from './SectionHeading.astro';

const reasons = [
  {
    initials: 'LG',
    title: 'Local Gardena Business',
    text: 'A physical business presence serving drivers in Gardena, California.',
  },
  {
    initials: 'PS',
    title: 'Professional Service',
    text: 'Clear, focused emissions testing information without unnecessary complexity.',
  },
  {
    initials: 'CL',
    title: 'Convenient Location',
    text: 'Located on W Gardena Blvd with contact details easy to find and use.',
  },
  {
    initials: 'EC',
    title: 'Easy to Contact',
    text: 'Call directly from the website or open directions to the business address.',
  },
];
---

<section id="about" class="section-spacing bg-section-bg">
  <div class="container-shell">
    <SectionHeading
      eyebrow="Why Choose Us"
      title="A Clear Local Presence"
      description="Smog Masters keeps the essential business details visible and consistent so customers can quickly confirm the location and get in touch."
      align="center"
    />

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        reasons.map((reason) => (
          <article class="rounded-lg border border-slate-200 bg-white p-6">
            <span class="mb-5 flex h-10 w-10 items-center justify-center rounded-md bg-green-50 text-sm font-bold text-brand-green">
              {reason.initials}
            </span>
            <h3 class="text-lg font-bold text-navy">{reason.title}</h3>
            <p class="mt-3 text-sm leading-6 text-text-secondary">{reason.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
