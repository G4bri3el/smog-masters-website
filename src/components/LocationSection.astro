---
import BusinessInfo from './BusinessInfo.astro';
import SectionHeading from './SectionHeading.astro';
import { site } from '../config/site';
---

<section id="location" class="section-spacing bg-white">
  <div class="container-shell">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div>
        <SectionHeading
          eyebrow="Location"
          title="Visit Smog Masters Smog Check"
          description="Find Smog Masters Smog Check at its Gardena business address and call directly for more information."
        />

        <div class="mt-8 rounded-lg border border-slate-200 bg-page-bg p-6 sm:p-8">
          <BusinessInfo />

          <div class="mt-7 flex flex-col gap-3 sm:flex-row">
            <a href={site.phoneHref} class="btn-primary" aria-label={`Call ${site.businessName}`}>
              Call Now
            </a>
            <a
              href={site.directionsUrl}
              class="btn-secondary"
              target="_blank"
              rel="noreferrer"
              aria-label={`Get directions to ${site.businessName}`}
            >
              Get Directions
            </a>
          </div>
        </div>
      </div>

      <div class="overflow-hidden rounded-lg border border-slate-200 bg-section-bg shadow-soft">
        {
          site.googleMapsEmbedUrl ? (
            <iframe
              src={site.googleMapsEmbedUrl}
              title={`${site.businessName} map`}
              class="h-80 w-full border-0 sm:h-96"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            />
          ) : (
            <div class="relative h-80 bg-[#E2E8F0] sm:h-96" aria-label={`${site.businessName} location panel`}>
              <div class="absolute inset-0 opacity-70">
                <div class="absolute left-0 top-12 h-3 w-full bg-white"></div>
                <div class="absolute left-0 top-40 h-3 w-full bg-white"></div>
                <div class="absolute left-0 top-[17rem] h-3 w-full bg-white"></div>
                <div class="absolute left-24 top-0 h-full w-3 bg-white"></div>
                <div class="absolute left-64 top-0 h-full w-3 bg-white"></div>
                <div class="absolute right-28 top-0 h-full w-3 bg-white"></div>
              </div>
              <div class="absolute left-1/2 top-1/2 w-[min(86%,28rem)] -translate-x-1/2 -translate-y-1/2 rounded-lg border border-slate-200 bg-white p-6 text-center shadow-soft">
                <p class="text-sm font-semibold uppercase text-brand-green">Gardena, CA Location</p>
                <p class="mt-3 text-xl font-bold text-navy">{site.businessName}</p>
                <p class="mt-2 text-text-secondary">
                  {site.address.street}<br />
                  {site.address.city}, {site.address.state} {site.address.zip}
                </p>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
