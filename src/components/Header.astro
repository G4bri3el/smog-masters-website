---
import { site } from '../config/site';

const navItems = [
  { href: '#services', label: 'Services' },
  { href: '#about', label: 'About' },
  { href: '#location', label: 'Location' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="container-shell flex min-h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3" aria-label={`${site.businessName} home`}>
      <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-navy text-sm font-bold text-white">
        SM
      </span>
      <span class="leading-tight">
        <span class="block text-sm font-bold text-navy sm:text-base">{site.shortName}</span>
        <span class="block text-xs font-medium text-text-secondary">{site.serviceName}</span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Main navigation">
      {
        navItems.map((item) => (
          <a href={item.href} class="text-sm font-semibold text-text-secondary hover:text-brand-green">
            {item.label}
          </a>
        ))
      }
    </nav>

    <a href={site.phoneHref} class="btn-primary min-w-28 px-4 py-3" aria-label={`Call ${site.businessName}`}>
      Call Now
    </a>
  </div>
</header>

