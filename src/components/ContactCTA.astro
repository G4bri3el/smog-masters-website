---
import { site } from '../config/site';
---

<section id="contact" class="bg-navy py-14 text-white sm:py-16">
  <div class="container-shell">
    <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
      <div>
        <p class="text-sm font-semibold uppercase text-green-200">Contact</p>
        <h2 class="mt-3 text-3xl font-bold leading-tight sm:text-4xl">Need a Smog Check?</h2>
        <p class="mt-4 max-w-2xl text-base leading-7 text-slate-200 sm:text-lg">
          Visit Smog Masters in Gardena or call today for more information.
        </p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:justify-end">
        <a href={site.phoneHref} class="btn-primary" aria-label={`Call ${site.businessName} at ${site.phoneDisplay}`}>
          Call {site.phoneDisplay}
        </a>
        <a
          href={site.directionsUrl}
          class="btn-on-dark"
          target="_blank"
          rel="noreferrer"
          aria-label={`Get directions to ${site.businessName}`}
        >
          Get Directions
        </a>
      </div>
    </div>
  </div>
</section>

